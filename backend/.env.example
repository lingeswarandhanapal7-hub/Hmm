# ====================================================================
# Hmm Backend Environment Configuration
# NEVER commit your real .env file with actual API keys!
# Copy this file to .env and insert your real credentials.
# ====================================================================

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Cloud API Key (with Cloud Vision API & Cloud Text-to-Speech API enabled)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_API_KEY=

# Server Port
PORT=3001

# Fallback mode: if true, returns high-fidelity fallback responses when API keys are not supplied
FALLBACK_MODE=true

# Local MySQL Server 8.0 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hmm_db

